<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/violet_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Document Tag and Similarity Score Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Document info tag -->
            <LinearLayout
                android:id="@+id/layout_doc_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/tv_score_badge"
                android:background="@color/violet_highlight"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tv_doc_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/violet_text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="sample_report.pdf • Page 3" />
            </LinearLayout>

            <!-- Similarity / Relevance score badge -->
            <TextView
                android:id="@+id/tv_score_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@color/score_badge_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/violet_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="88.5% Match" />
        </RelativeLayout>

        <!-- Chunk text label -->
        <TextView
            android:id="@+id/tv_chunk_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/violet_text_dark"
            android:textSize="14sp"
            tools:text="The sentence-transformers library allows computing vector embeddings for sentences and paragraphs. FAISS enables efficient similarity search across millions of vectors using inner product or L2 distance." />

        <!-- Chunk ID info -->
        <TextView
            android:id="@+id/tv_chunk_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/violet_text_secondary"
            android:textSize="11sp"
            tools:text="Chunk ID: #14" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
